# Resend API Configuration for Pitaj Waitlist
# Dobavite API ključ na: https://resend.com/api-keys
RESEND_API_KEY=re_123456789_abcdefg

# Pošiljalac (From) e-mail adresa
# Napomena: Za slanje sa @pitaj.io domene, domena mora biti verifikovana na Resend dashboardu.
# Tokom testiranja možete koristiti 'Pitaj.io <onboarding@resend.dev>'
RESEND_FROM_EMAIL="Pitaj.io <info@pitaj.io>"

# (Opcionalno) Resend Audience / Publika ID za automatsko spremanje kontakata
# Dobavite ID na: https://resend.com/audiences
# RESEND_AUDIENCE_ID=

# (Opcionalno) Interna e-mail adresa za obavještenja o novim prijavama
# RESEND_NOTIFY_EMAIL=osnivaci@pitaj.io
