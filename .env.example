# Turso Database Configuration for Pitaj Waitlist
TURSO_DATABASE_URL="libsql://pitajio-waitlist-davidvidovic-web.aws-eu-west-1.turso.io"

# Auth token dobiven preko Turso CLI (`turso db tokens create pitajio-waitlist`) ili Turso Dashboarda
TURSO_AUTH_TOKEN="your-turso-auth-token-here"

# Potvrda prijave mailom kroz Pitaj API. Ista tajna kao WAITLIST_API_SECRET u pitaj-api; bez nje se potvrda ne šalje.
PITAJ_API_URL="https://api.pitaj.io"
WAITLIST_API_SECRET=""
