---
import { Icon } from 'astro-icon/components';

// Jedino mjesto za adresu Instagram profila.
const INSTAGRAM_URL = 'https://www.instagram.com/pitaj.io';
---

<!-- Main Footer Container with Full-Width Blue Background and Cut-in White Card -->
<footer class="relative isolate w-full">
  <div class="relative isolate w-full">
    <!-- Blue textured background spanning the ENTIRE footer section -->
    <div aria-hidden="true" class="-z-10 pointer-events-none absolute inset-0 bg-brand">
    </div>

    <!-- White Content Box -->
    <div class="relative z-10 mx-auto max-w-[1240px] bg-white border-t lg:border-x border-b border-line">
      <!-- Diamond lattice divider row (aligns exactly with the start of the footer) -->
      <div class="border-b border-line">
        <svg aria-hidden="true" width="100%" height="24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-6 w-full text-line">
          <title>Diamond row divider</title>
          <defs>
            <pattern id="diamond-row-divider" width="23.3725" height="24" patternUnits="userSpaceOnUse">
              <path d="M11.6863 1.0208 L22.6655 12 L11.6863 22.9792 L0.7071 12 Z" stroke="currentColor"></path>
            </pattern>
          </defs>
          <rect width="100%" height="24" fill="url(#diamond-row-divider)"></rect>
        </svg>
      </div>

      <div class="px-6 py-12 sm:px-12 lg:px-16">
        <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[minmax(0,1.6fr)_1fr_1fr]">
          <!-- Brend -->
          <div class="flex flex-col items-start gap-3">
            <a href="/" class="group flex items-center gap-2.5 text-ink" aria-label="pitaj.io početna">
              <svg class="h-6 w-6 shrink-0 rounded-md shadow-xs" viewBox="0 0 28 28" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect width="28" height="28" rx="6" fill="currentColor" class="text-ink"/>
                <path fill="#fff" fill-rule="evenodd" d="M6.1 23V5H15.8 C19.4 5 21.6 7.2 21.6 10.6 C21.6 14 19.4 16.2 15.8 16.2 H11V23H6.1Z M11 9.1V12.2H15.4 C16.6 12.2 17.3 11.6 17.3 10.6 C17.3 9.6 16.6 9.1 15.4 9.1H11Z"/>
              </svg>
              <span class="text-[18px] font-semibold tracking-tight text-ink">pitaj<span class="font-normal text-subtle">.io</span></span>
            </a>
            <p class="max-w-[34ch] text-[14px] leading-snug text-muted">
              Platforma za pametne AI agente u korisničkoj podršci i prodaji.
            </p>
          </div>

          <!-- Poveznice -->
          <nav aria-label="Poveznice u podnožju">
            <h2 class="text-[13px] font-semibold text-ink">Resursi</h2>
            <ul class="mt-2 flex flex-col text-[14px] text-muted">
              <li><a href="https://docs.pitaj.io/quick-start/build-first-agent/" class="inline-flex min-h-9 items-center transition-colors hover:text-ink">Prvih 15 minuta</a></li>
              <li><a href="/cijene" class="inline-flex min-h-9 items-center transition-colors hover:text-ink">Cijene</a></li>
              <li>
                <a href="https://docs.pitaj.io" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-9 items-center transition-colors hover:text-ink">
                  Dokumentacija<span class="sr-only"> (otvara se u novoj kartici)</span>
                </a>
              </li>
              <li>
                <a href="https://changelog.pitaj.io" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-9 items-center gap-2 transition-colors hover:text-ink">
                  <span>Changelog</span>
                  <span class="rounded-full border border-line bg-wash px-2 py-0.5 text-[11px] font-semibold leading-none text-muted">Beta</span>
                  <span class="sr-only">(otvara se u novoj kartici)</span>
                </a>
              </li>
              <li>
                <a href="https://app.pitaj.io" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-9 items-center transition-colors hover:text-ink">
                  Dashboard<span class="sr-only"> (otvara se u novoj kartici)</span>
                </a>
              </li>
            </ul>
          </nav>

          <!-- Društvene mreže -->
          <div>
            <h2 class="text-[13px] font-semibold text-ink">Pratite nas</h2>
            <ul class="mt-2 flex flex-col text-[14px] text-muted">
              <li>
                <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-9 items-center gap-2.5 transition-colors hover:text-ink">
                  <Icon name="simple-icons:instagram" class="h-4 w-4" aria-hidden="true" />
                  <span>Instagram<span class="sr-only"> (otvara se u novoj kartici)</span></span>
                </a>
              </li>
            </ul>
          </div>
        </div>

        <!-- Pravno -->
        <div class="mt-10 flex flex-col gap-x-6 gap-y-1 border-t border-line pt-6 text-[13px] text-subtle sm:flex-row sm:items-center sm:justify-between">
          <p>© 2026 Pitaj.io. Sva prava zadržana.</p>
          <button type="button" data-consent-reset class="inline-flex min-h-9 cursor-pointer items-center self-start text-[13px] text-subtle underline underline-offset-2 transition-colors hover:text-ink sm:self-auto">Postavke privatnosti</button>
        </div>
      </div>
    </div>

    <!-- Giant Wordmark Banner at the bottom -->
    <div class="relative overflow-hidden">
      <!-- Desktop Banner -->
      <div class="relative mx-auto hidden max-w-[1240px] lg:block" style="aspect-ratio: 1240 / 250;">
        <img
          alt="PITAJ.IO"
          class="pointer-events-none absolute -bottom-[5%] left-1/2 -translate-x-1/2 w-[99%] max-w-none select-none"
          src="/brand/pitaj-wordmark.svg"
          loading="lazy"
        />
      </div>

      <!-- Mobile Banner -->
      <div class="relative h-28 w-full overflow-hidden pt-4 lg:hidden">
        <img
          alt="PITAJ.IO"
          class="pointer-events-none absolute -bottom-[5%] left-1/2 -translate-x-1/2 w-[110%] max-w-none select-none"
          src="/brand/pitaj-wordmark.svg"
          loading="lazy"
        />
      </div>
    </div>

  </div>
</footer>
