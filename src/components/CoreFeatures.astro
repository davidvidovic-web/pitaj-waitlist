---
---

<section class="reveal-on-scroll w-full bg-white">
  <div class="mx-auto max-w-[1240px] px-6 py-16 lg:border-x lg:border-b border-[#e4e4e7] lg:px-16 lg:py-20">
    <div class="max-w-[780px]">
      <h2 class="text-balance text-[1.85rem] font-medium leading-[1.18] tracking-[-0.025em] text-[#09090b] sm:text-[2.25rem] lg:text-[2.5rem]">
        Sve što vam je potrebno za <span class="font-proza italic font-normal">potpunu automatizaciju</span> komunikacije
      </h2>
    </div>

    <!-- 3 Core Bento Cards Grid -->
    <div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-3">
      
      <!-- Card 1: Omnichannel Presence -->
      <div class="group flex flex-col justify-between overflow-hidden rounded-2xl border border-[#e4e4e7] bg-[#fafafa] p-7 transition-all duration-300 hover:shadow-lg hover:border-[#d4d4d8] hover:-translate-y-1">
        <div>
          <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-[#e4e4e7] bg-white shadow-xs text-[#09090b]">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
          </div>
          <h3 class="mt-6 text-[18px] font-semibold text-[#09090b]">Web chat, WhatsApp & Instagram</h3>
          <p class="mt-2.5 text-[14px] leading-relaxed text-[#52525b]">
            Objedinite sve dolazne poruke na jednom mjestu. Vaš AI agent razgovara s kupcima na njihovim omiljenim kanalima bez čekanja na operatera.
          </p>
        </div>

        <div class="mt-8 rounded-xl border border-[#e4e4e7] bg-white p-4 shadow-2xs">
          <div class="flex items-center justify-between text-[12px]">
            <span class="font-medium text-[#09090b]">Prosječno vrijeme odgovora</span>
            <span class="font-mono font-bold text-emerald-600">&lt; 1 sekunda</span>
          </div>
          <div class="mt-2 w-full bg-slate-100 rounded-full h-1.5 overflow-hidden">
            <div class="bg-emerald-500 h-full w-[94%] rounded-full"></div>
          </div>
          <div class="mt-2 text-[11px] text-[#71717a]">94% upita riješeno u prvom kontaktu</div>
        </div>
      </div>

      <!-- Card 2: Deep Data Integration -->
      <div class="group flex flex-col justify-between overflow-hidden rounded-2xl border border-[#e4e4e7] bg-[#fafafa] p-7 transition-all duration-300 hover:shadow-lg hover:border-[#d4d4d8] hover:-translate-y-1">
        <div>
          <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-[#e4e4e7] bg-white shadow-xs text-[#09090b]">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <ellipse cx="12" cy="5" rx="9" ry="3"/>
              <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/>
              <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>
            </svg>
          </div>
          <h3 class="mt-6 text-[18px] font-semibold text-[#09090b]">Povezivanje sa zalihama i bazom</h3>
          <p class="mt-2.5 text-[14px] leading-relaxed text-[#52525b]">
            Povežite agenta sa WooCommerce ili Shopify katalogom, PDF cjenovnicima i internim procedurama. Agent provjerava status narudžbe i preporučuje proizvode.
          </p>
        </div>

        <div class="mt-8 rounded-xl border border-[#e4e4e7] bg-white p-4 shadow-2xs">
          <div class="flex items-center gap-2 text-[12px] font-medium text-[#09090b]">
            <span class="flex h-2 w-2 rounded-full bg-blue-600"></span>
            <span>Sinhronizacija u realnom vremenu</span>
          </div>
          <p class="mt-1.5 text-[11px] text-[#71717a] font-mono">
            WooCommerce API • Shopify Webhooks • PDF & Docs
          </p>
        </div>
      </div>

      <!-- Card 3: Human Copilot -->
      <div class="group flex flex-col justify-between overflow-hidden rounded-2xl border border-[#e4e4e7] bg-[#fafafa] p-7 transition-all duration-300 hover:shadow-lg hover:border-[#d4d4d8] hover:-translate-y-1">
        <div>
          <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-[#e4e4e7] bg-white shadow-xs text-[#09090b]">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <h3 class="mt-6 text-[18px] font-semibold text-[#09090b]">Hibridni rad & 1-klik preuzimanje</h3>
          <p class="mt-2.5 text-[14px] leading-relaxed text-[#52525b]">
            Kada kupac zatraži čovjeka ili se pojavi osjetljivo pitanje, vaš tim u 1 klik preuzima razgovor uz kompletan sažetak i predložene odgovore.
          </p>
        </div>

        <div class="mt-8 rounded-xl border border-[#e4e4e7] bg-white p-4 shadow-2xs">
          <div class="flex items-center justify-between text-[12px]">
            <span class="font-medium text-[#09090b]">Ušteda vremena tima</span>
            <span class="font-mono font-bold text-blue-600">75% manje ticketa</span>
          </div>
          <div class="mt-2 w-full bg-slate-100 rounded-full h-1.5 overflow-hidden">
            <div class="bg-blue-600 h-full w-[75%] rounded-full"></div>
          </div>
          <div class="mt-2 text-[11px] text-[#71717a]">Tim se fokusira na ključne prodajne razgovore</div>
        </div>
      </div>

    </div>
  </div>
</section>
