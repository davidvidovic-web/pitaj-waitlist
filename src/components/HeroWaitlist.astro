---
import WaitlistForm from './WaitlistForm.astro';
---

<section id="waitlist-form" class="w-full bg-white overflow-visible scroll-mt-16">
  <div class="mx-auto max-w-[1240px] lg:border-x lg:border-b border-line">
    <!-- Hero Main Row -->
    <div class="relative overflow-hidden lg:flex">
      <!-- Left Column: Copy & Demo Form -->
      <div class="relative flex flex-1 flex-col items-start justify-center px-6 pt-12 pb-10 text-left lg:min-h-[660px] lg:px-16 lg:py-16">
        
        <!-- Broj prijava: prikazuje se samo kad API vrati stvarni broj iznad praga -->
        <div id="waitlist-count-badge" hidden class="animate-chip-rise flex items-center gap-2.5 rounded-full border border-line bg-sunken px-3.5 py-1.5 shadow-xs">
          <span class="text-[13px] font-medium text-muted"><strong id="waitlist-count" class="font-semibold text-ink"></strong> kompanija već osiguralo rani pristup</span>
        </div>

        <!-- Headline -->
        <h1 class="mt-6 max-w-[560px] text-balance text-[2.5rem] font-medium leading-[1.08] tracking-[-0.035em] text-ink sm:text-[3.25rem] lg:text-[3.75rem]">
          Pametni AI <span class="font-proza font-bold italic">agenti</span> koji <span class="font-proza font-bold italic">poznaju</span> vaš biznis
        </h1>

        <!-- Subheading -->
        <p class="mt-5 max-w-[520px] text-[16px] leading-[1.5] text-muted sm:text-[18px]">
          Povežite web sajt, web trgovinu i dokumente. Pitaj.io agenti odgovaraju na upite kupaca 24/7 na webu, WhatsAppu i Instagramu, provjeravaju narudžbe i povećavaju prodaju.
        </p>

        <div class="mt-8 flex flex-wrap gap-3"><a href="https://app.pitaj.io/register" class="rounded-lg bg-ink px-5 py-3 font-medium text-white">Počnite besplatno</a><a href="#demo" class="rounded-lg border border-line px-5 py-3 font-medium text-ink">Zakažite demo</a></div>
        <!-- Demo request form -->
        <div class="mt-8 w-full max-w-[520px]">
          <WaitlistForm
            prefix="hero"
            source="hero"
            placeholder="Vaš poslovni e-mail"
            buttonLabel="Zakažite demo"
            successTitle="Prijava je zaprimljena."
            successText="Javit ćemo vam se e-mailom radi dogovora demo prezentacije."
          />

          <!-- Link to Perks Section -->
          <div class="mt-4 flex items-center">
            <a
              href="#pogodnosti"
              class="group inline-flex min-h-8 items-center gap-1.5 text-[13.5px] font-medium text-subtle hover:text-brand transition-colors"
            >
              <span>Pogledajte pogodnosti za beta korisnike</span>
              <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </div>

      </div>

      <!-- Right Column: primjer razgovora (ilustracija proizvoda) -->
      <div class="relative flex w-full items-center justify-center overflow-hidden bg-night px-6 py-12 lg:min-h-[660px] lg:w-[540px] lg:shrink-0 lg:border-l lg:border-line lg:px-10">
        <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(120%_80%_at_85%_0%,var(--color-brand)_0%,transparent_60%)] opacity-70"></div>

        <figure class="relative w-full max-w-[400px]" aria-label="Primjer razgovora s Pitaj.io agentom">
          <div class="flex items-center gap-2.5 pb-4">
            <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-white text-ink">
              <svg class="h-4 w-4" viewBox="0 0 28 28" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M6.1 23V5H15.8 C19.4 5 21.6 7.2 21.6 10.6 C21.6 14 19.4 16.2 15.8 16.2 H11V23H6.1Z M11 9.1V12.2H15.4 C16.6 12.2 17.3 11.6 17.3 10.6 C17.3 9.6 16.6 9.1 15.4 9.1H11Z"/></svg>
            </span>
            <div class="text-[13px] leading-tight">
              <div class="font-semibold text-white">Agent za web trgovinu</div>
              <div class="text-brand-tint">Odgovara iz vašeg kataloga</div>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <div class="ml-auto max-w-[85%] rounded-2xl rounded-br-md bg-brand px-4 py-3 text-[14px] leading-snug text-white">
              Imate li jaknu Alpina u veličini M?
            </div>
            <div class="max-w-[92%] rounded-2xl rounded-bl-md bg-white px-4 py-3 text-[14px] leading-snug text-ink-soft shadow-[0_8px_24px_-8px_rgba(0,0,0,0.45)]">
              Da, jakna Alpina u veličini M je dostupna. Mogu vam poslati link za narudžbu ili provjeriti status dostave.
              <div class="mt-3 flex flex-wrap gap-2">
                <span class="rounded-full border border-line bg-sunken px-3 py-1 text-[12px] font-medium text-ink-soft">Naruči</span>
                <span class="rounded-full border border-line bg-sunken px-3 py-1 text-[12px] font-medium text-ink-soft">Status dostave</span>
              </div>
            </div>
            <div class="ml-auto max-w-[85%] rounded-2xl rounded-br-md bg-brand px-4 py-3 text-[14px] leading-snug text-white">
              Može li zamjena ako ne odgovara?
            </div>
          </div>
          <figcaption class="mt-5 text-[12px] text-brand-tint">Ilustracija: primjer razgovora, ne stvarni podaci.</figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<script>
  // Stvarni broj prijava (API vraća null ispod praga ili kad baza nije dostupna).
  const badge = document.getElementById('waitlist-count-badge');
  const countEl = document.getElementById('waitlist-count');
  if (badge && countEl) {
    fetch('/api/waitlist')
      .then((response) => (response.ok ? response.json() : null))
      .then((data) => {
        if (typeof data?.count === 'number') {
          countEl.textContent = String(data.count);
          badge.hidden = false;
        }
      })
      .catch(() => {});
  }
</script>
