---
const industries = [
  {
    id: 'retail',
    href: '#waitlist-form',
    title: 'Web Trgovine & E-Commerce',
    tagline: 'Kupci žele znati veličinu, cijenu dostave i status paketa odmah.',
    description: 'Agent povezan s WooCommerce ili Shopify katalogom odgovara na upite o zalihama, vodi posjetioce do kupovine i smanjuje napuštene košarice.',
    badge: 'E-Commerce',
    video: '/chatbase-assets/industry-retail.mp4',
    gradient: 'from-[#1e1b4b]/95 via-[#1e1b4b]/40 to-transparent',
    accentColor: '#4f46e5'
  },
  {
    id: 'tech',
    href: '#waitlist-form',
    title: 'Agencije & Tehnologija',
    tagline: 'Pružite klijentima AI agente pod vlastitim brendom i domenom.',
    description: 'Multi-client platforma za digitalne agencije. Uvođenje u par minuta uz potpunu whitelabel podršku i centralizirano upravljanje računima.',
    badge: 'SaaS & Agencije',
    video: '/chatbase-assets/industry-technology.mp4',
    gradient: 'from-[#064e3b]/95 via-[#064e3b]/40 to-transparent',
    accentColor: '#059669'
  },
  {
    id: 'hospitality',
    href: '#waitlist-form',
    title: 'Hoteli, Apartmani & Turizam',
    tagline: 'Gosti pitaju za slobodne sobe, parking, doručak i check-in u svako doba.',
    description: 'Višejezični asistent odgovara domaćim i stranim turistima na njihovom jeziku te šalje upute i direktne linkove za rezervaciju smještaja.',
    badge: 'Turizam & Ugostiteljstvo',
    video: '/chatbase-assets/industry-hospitality.mp4',
    gradient: 'from-[#78350f]/95 via-[#78350f]/40 to-transparent',
    accentColor: '#d97706'
  },
  {
    id: 'healthcare',
    href: '#waitlist-form',
    title: 'Poliklinike, Zdravstvo & Usluge',
    tagline: 'Pacijenti traže termine, pripremu za pregled i cijene i van radnog vremena.',
    description: 'Pružite pouzdane informacije 24/7, rasteretite medicinsko osoblje telefonskih poziva i automatski prikupite termine za preglede i tretmane.',
    badge: 'Zdravstvo & Saloni',
    video: '/chatbase-assets/industry-financial-services.mp4',
    gradient: 'from-[#1e293b]/95 via-[#1e293b]/40 to-transparent',
    accentColor: '#0284c7'
  }
];
---

<section class="reveal-on-scroll w-full bg-white overflow-visible border-b border-[#e4e4e7]">
  <div class="mx-auto max-w-[1240px] px-6 py-16 lg:border-x border-[#e4e4e7] lg:px-16 lg:py-20">
    <!-- Header with Prev/Next Controls -->
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-2 rounded-full border border-[#e4e4e7] bg-[#fafafa] px-3.5 py-1.5 text-[12px] font-semibold uppercase tracking-wider text-[#09090b]">
          Prilagođena rješenja
        </div>
        <h2 class="mt-4 text-[1.85rem] font-medium leading-[1.18] tracking-[-0.025em] text-[#09090b] sm:text-[2.25rem] lg:text-[2.5rem]">
          Izgrađeno za <span class="font-proza font-bold italic">vašu</span> industriju
        </h2>
        <p class="mt-2 text-[16px] text-[#52525b]">
          Prilagođeni scenariji i rješenja optimizirana za stvarne potrebe vašeg poslovanja.
        </p>
      </div>

      <!-- Arrow Navigation for Carousel / Accordion on Desktop -->
      <div class="hidden items-center lg:flex">
        <button
          id="prev-industry-btn"
          type="button"
          aria-label="Prethodna industrija"
          class="-ml-px flex h-12 w-12 cursor-pointer items-center justify-center border border-[#e4e4e7] bg-white transition-colors hover:bg-[#fafafa] active:bg-[#f4f4f5] rounded-l-lg"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <path d="M19 12H5M12 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button
          id="next-industry-btn"
          type="button"
          aria-label="Sljedeća industrija"
          class="-ml-px flex h-12 w-12 cursor-pointer items-center justify-center border border-[#e4e4e7] bg-white transition-colors hover:bg-[#fafafa] active:bg-[#f4f4f5] rounded-r-lg"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Desktop: Chatbase Expanding Video Accordion -->
    <div id="industry-accordion" class="mt-12 hidden h-[560px] gap-4 lg:flex">
      {industries.map((ind, index) => (
        <div
          class={`industry-card group relative isolate min-w-0 overflow-hidden rounded-2xl border border-[#e4e4e7] transition-all cursor-pointer shadow-md ${index === 0 ? 'is-active flex-[6_1_0%]' : 'flex-[1.2_1_0%]'}`}
          data-index={index}
          style="transition: flex-grow 620ms cubic-bezier(0.23, 1, 0.32, 1), box-shadow 300ms ease;"
        >
          <!-- Background Looping Video -->
          <video
            src={ind.video}
            muted
            loop
            autoplay
            playsinline
            preload="auto"
            class="pointer-events-none absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
            style="transform: scale(1.08);"
          ></video>

          <!-- Gradient Overlay -->
          <div class={`pointer-events-none absolute inset-0 bg-gradient-to-t ${ind.gradient}`}></div>

          <!-- Glassmorphic Bottom Backdrop -->
          <div class="pointer-events-none absolute inset-x-0 bottom-0 h-[180px] backdrop-blur-md [mask-image:linear-gradient(to_bottom,transparent,black)]"></div>

          <!-- Collapsed Label (shown when not active) -->
          <div class="industry-collapsed-label absolute inset-0 flex flex-col justify-end p-6 transition-opacity duration-300" style={index === 0 ? 'opacity: 0; pointer-events: none;' : 'opacity: 1;'}>
            <span class="rounded-md border border-white/20 bg-black/40 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-white backdrop-blur-md w-max">
              {ind.badge}
            </span>
            <div class="mt-3 text-[18px] font-semibold text-white tracking-tight leading-snug">
              {ind.title}
            </div>
          </div>

          <!-- Expanded Content (shown when active) -->
          <div class="industry-expanded-content absolute inset-0 flex flex-col justify-end p-8 transition-opacity duration-500" style={index === 0 ? 'opacity: 1; pointer-events: auto;' : 'opacity: 0; pointer-events: none;'}>
            <span class="rounded-md border border-white/30 bg-black/40 px-3 py-1 text-[11px] font-semibold uppercase tracking-wider text-white backdrop-blur-md w-max">
              {ind.badge}
            </span>
            <h3 class="mt-4 text-[26px] font-semibold text-white tracking-tight leading-tight">
              {ind.title}
            </h3>
            <p class="mt-2 text-[15px] font-medium text-white/90 max-w-[480px]">
              {ind.tagline}
            </p>
            <p class="mt-2 text-[13px] text-white/75 max-w-[500px] leading-relaxed">
              {ind.description}
            </p>
            <div class="mt-5 flex items-center gap-2">
              <a
                href={ind.href}
                class="inline-flex items-center gap-2 rounded-lg bg-white px-4 py-2 text-[13px] font-semibold text-[#09090b] shadow-sm transition-transform hover:scale-105"
              >
                Istraži rješenje
                <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M6 12l4-4-4-4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Mobile & Tablet: Responsive Video Cards Stack -->
    <div class="mt-8 flex flex-col gap-6 lg:hidden">
      {industries.map((ind) => (
        <div class="relative overflow-hidden rounded-2xl border border-[#e4e4e7] min-h-[360px] shadow-sm">
          <video
            src={ind.video}
            muted
            loop
            autoplay
            playsinline
            preload="auto"
            class="pointer-events-none absolute inset-0 h-full w-full object-cover"
          ></video>
          <div class={`pointer-events-none absolute inset-0 bg-gradient-to-t ${ind.gradient}`}></div>
          <div class="relative z-10 flex h-full min-h-[360px] flex-col justify-end p-6">
            <span class="rounded-md border border-white/30 bg-black/40 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-white backdrop-blur-md w-max">
              {ind.badge}
            </span>
            <h3 class="mt-3 text-[20px] font-semibold text-white">{ind.title}</h3>
            <p class="mt-1 text-[13px] text-white/90">{ind.tagline}</p>
            <p class="mt-2 text-[12px] text-white/70">{ind.description}</p>
            <a href={ind.href} class="mt-4 inline-flex items-center gap-1.5 text-[13px] font-semibold text-white underline">
              Saznajte više
              <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 12l4-4-4-4"/></svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Chatbase-like Interactive Video Accordion Logic
  const cards = document.querySelectorAll<HTMLElement>('.industry-card');
  const prevBtn = document.getElementById('prev-industry-btn');
  const nextBtn = document.getElementById('next-industry-btn');
  let currentIndex = 0;

  function setActiveCard(index: number) {
    currentIndex = index;
    cards.forEach((card, idx) => {
      const collapsedLabel = card.querySelector<HTMLElement>('.industry-collapsed-label');
      const expandedContent = card.querySelector<HTMLElement>('.industry-expanded-content');

      if (idx === index) {
        card.style.flexGrow = '6';
        card.classList.add('is-active');
        if (collapsedLabel) {
          collapsedLabel.style.opacity = '0';
          collapsedLabel.style.pointerEvents = 'none';
        }
        if (expandedContent) {
          expandedContent.style.opacity = '1';
          expandedContent.style.pointerEvents = 'auto';
        }
      } else {
        card.style.flexGrow = '1.2';
        card.classList.remove('is-active');
        if (collapsedLabel) {
          collapsedLabel.style.opacity = '1';
          collapsedLabel.style.pointerEvents = 'auto';
        }
        if (expandedContent) {
          expandedContent.style.opacity = '0';
          expandedContent.style.pointerEvents = 'none';
        }
      }
    });
  }

  cards.forEach((card, idx) => {
    card.addEventListener('mouseenter', () => setActiveCard(idx));
    card.addEventListener('click', () => setActiveCard(idx));
  });

  if (prevBtn) {
    prevBtn.addEventListener('click', () => {
      const nextIdx = (currentIndex - 1 + cards.length) % cards.length;
      setActiveCard(nextIdx);
    });
  }

  if (nextBtn) {
    nextBtn.addEventListener('click', () => {
      const nextIdx = (currentIndex + 1) % cards.length;
      setActiveCard(nextIdx);
    });
  }
</script>
