---
import { Icon } from 'astro-icon/components';

const perks = [
  {
    icon: 'lucide:rocket',
    title: 'Prioritetni & besplatan onboarding',
    description:
      'Naš inženjerski tim će lično pomoći u integraciji sa vašim webshopom, treniranju agenta na vašim podacima i podešavanju specifičnih procedura.',
  },
  {
    icon: 'lucide:badge-percent',
    title: '-40% popusta na prvu godinu',
    description:
      'Svi članovi liste čekanja ostvaruju trajno zaključanu cijenu za rane korisnike, znatno povoljniju od redovnih javnih paketa.',
  },
  {
    icon: 'lucide:sliders-horizontal',
    title: 'Direktan uticaj na nove opcije',
    description:
      'Vaše specifične potrebe i integracije (npr. lokalni ERP ili kurirska služba) dobijaju najviši prioritet u našem razvojnom planu.',
  },
];
---

<section class="reveal-on-scroll w-full bg-[#fafafa]/80 border-b border-[#e4e4e7]">
  <div class="mx-auto max-w-[1240px] px-6 py-20 lg:border-x border-[#e4e4e7] lg:px-16 lg:py-24">
    
    <!-- Section Header -->
    <div class="max-w-[720px] mx-auto text-center">
      <h2 class="text-balance text-[2rem] sm:text-[2.25rem] lg:text-[2.5rem] font-medium leading-[1.15] tracking-[-0.03em] text-[#09090b]">
        Rani pristup. <span class="font-proza italic font-normal">Trajne prednosti.</span>
      </h2>
      <p class="mt-4 text-[15px] sm:text-[16px] leading-[1.55] text-[#52525b]">
        Pridružite se listi čekanja i ostvarite ekskluzivne pogodnosti, uz podršku našeg tima od prvog dana.
      </p>
    </div>

    <!-- 3 Perks Grid -->
    <div class="mt-12 sm:mt-14 grid grid-cols-1 md:grid-cols-3 gap-6">
      {perks.map((perk) => (
        <div class="group relative flex flex-col justify-start rounded-2xl border border-[#e4e4e7] bg-white p-7 sm:p-8 shadow-xs transition-all duration-300 hover:border-[#d4d4d8] hover:shadow-lg hover:-translate-y-1">
          <!-- Card Icon -->
          <div>
            <div class="flex h-11 w-11 items-center justify-center rounded-xl border border-[#e4e4e7] bg-[#fafafa] text-[#162ea8] shadow-2xs transition-all duration-300 group-hover:scale-105 group-hover:bg-[#162ea8] group-hover:text-white group-hover:border-[#162ea8]">
              <Icon name={perk.icon} class="h-5 w-5 stroke-[2]" />
            </div>
          </div>

          <!-- Title & Description -->
          <h3 class="mt-6 text-[18px] sm:text-[19px] font-semibold tracking-tight text-[#09090b]">
            {perk.title}
          </h3>
          <p class="mt-2.5 text-[14px] sm:text-[14.5px] leading-relaxed text-[#52525b]">
            {perk.description}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
