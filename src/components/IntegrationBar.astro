---
import { Icon } from 'astro-icon/components';

const channels = [
  {
    name: 'WhatsApp',
    description: 'Automatizirajte korisničku podršku i prodajne upite direktno preko WhatsApp Business API-ja.',
    icon: 'whatsapp',
  },
  {
    name: 'Instagram',
    description: 'Odgovarajte na DM upite i komentare kupaca u roku od sekunde, 24 sata dnevno bez pauze.',
    icon: 'instagram',
  },
  {
    name: 'Slack',
    description: 'Obavijesti o novim upitima, internim eskalacijama i 1-klik preuzimanje razgovora unutar vašeg tima.',
    icon: 'slack',
  },
  {
    name: 'Website Popup & Chat',
    description: 'Prilagodljivi chat widget za vaš web sajt koji proaktivno vodi posjetioce kroz ponudu i prikuplja kontakte.',
    icon: 'website',
  },
  {
    name: 'Telegram',
    description: 'Brz i pouzdan kanal za direktnu komunikaciju sa kupcima i automatsko slanje statusa narudžbi.',
    icon: 'telegram',
  },
  {
    name: 'Messenger',
    description: 'Povežite svoju Facebook stranicu i automatski vodite prodajne razgovore kroz Facebook Messenger.',
    icon: 'messenger',
  },
  {
    name: 'Shopify',
    description: 'Automatska provjera stanja zaliha, statusa pošiljki i preporuke proizvoda direktno u razgovoru.',
    icon: 'shopify',
  },
  {
    name: 'WooCommerce',
    description: 'Povežite WordPress webshop za uvid u katalog proizvoda, cijene i narudžbe kupaca u realnom vremenu.',
    icon: 'woocommerce',
  },
  {
    name: 'API & Webhooks',
    description: 'Povežite bilo koji interni ERP, CRM ili eksterni softver preko naših fleksibilnih webhooks integracija.',
    icon: 'webhook',
  },
];
---

<section class="reveal-on-scroll w-full bg-[#fafafa]/80 border-b border-[#e4e4e7]">
  <div class="mx-auto max-w-[1240px] px-6 py-16 lg:px-16 lg:py-24 lg:border-x border-[#e4e4e7]">
    
    <!-- Attio-style 2-Column Section Header -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 lg:gap-12 pb-12 sm:pb-14">
      <div class="max-w-[560px]">
        <h2 class="text-balance text-[2rem] sm:text-[2.35rem] lg:text-[2.6rem] font-medium leading-[1.12] tracking-[-0.03em] text-[#09090b]">
          Povežite agente <span class="font-proza italic font-normal">s vašim kanalima</span> i alatima.
        </h2>
      </div>
      <div class="max-w-[460px]">
        <p class="text-[15px] sm:text-[16px] leading-[1.6] text-[#52525b]">
          Pitaj.io se neprimjetno integriše sa kanalima koje vaši kupci i tim već koriste svakodnevno. Automatizirajte odgovore 24/7 bez mijenjanja postojećeg načina rada.
        </p>
      </div>
    </div>

    <!-- Attio-style 3x3 Card Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6">
      {channels.map((channel) => (
        <div class="group flex items-start gap-4 rounded-2xl border border-[#e4e4e7] bg-white p-6 shadow-xs transition-all duration-200 hover:border-[#d4d4d8] hover:shadow-md hover:-translate-y-0.5">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#e4e4e7] bg-[#fafafa] p-2.5 shadow-2xs transition-transform duration-200 group-hover:scale-105">
            <Icon name={channel.icon} class="h-7 w-7 object-contain" />
          </div>
          <div class="min-w-0 flex-1">
            <h3 class="text-[16px] font-semibold text-[#09090b] tracking-tight">
              {channel.name}
            </h3>
            <p class="mt-1 text-[13.5px] leading-relaxed text-[#52525b]">
              {channel.description}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
