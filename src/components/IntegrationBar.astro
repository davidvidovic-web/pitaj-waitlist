---
import { Icon } from 'astro-icon/components';

const integrations = [
  { name: 'Website Popup', icon: 'website' },
  { name: 'WhatsApp', icon: 'whatsapp' },
  { name: 'Instagram', icon: 'instagram' },
  { name: 'Facebook', icon: 'facebook' },
  { name: 'Messenger', icon: 'messenger' },
  { name: 'Viber', icon: 'viber' },
  { name: 'Shopify', icon: 'shopify' },
  { name: 'WooCommerce', icon: 'woocommerce' },
];
---

<section class="w-full bg-[#fafafa]/80 border-b border-[#e4e4e7]">
  <div class="mx-auto max-w-[1240px] px-6 py-10 lg:px-16 lg:border-x border-[#e4e4e7]">
    <div class="text-center text-[12px] font-semibold uppercase tracking-wider text-[#a1a1aa] mb-6">
      Povezuje se u nekoliko minuta s vašim omiljenim kanalima i sistemima
    </div>

    <!-- Desktop 8-cell Grid (Clean Official Brand Logos with Subtle Labels) -->
    <div class="hidden lg:grid lg:grid-cols-8 border border-[#e4e4e7] rounded-xl overflow-hidden bg-white shadow-2xs divide-x divide-[#e4e4e7]">
      {integrations.map((item) => (
        <div 
          class="group relative flex h-24 flex-col items-center justify-center px-2 py-3 transition-all duration-200 ease-out hover:bg-slate-50/80 cursor-default"
          title={item.name}
        >
          <div class="h-10 w-10 flex items-center justify-center transition-transform duration-200 ease-out group-hover:scale-110 drop-shadow-2xs">
            <Icon 
              name={item.icon} 
              class="h-9 w-9 object-contain"
            />
          </div>
          <span class="mt-2 text-[11px] font-medium tracking-tight text-[#71717a] transition-colors duration-200 group-hover:text-[#09090b]">
            {item.name}
          </span>
        </div>
      ))}
    </div>

    <!-- Mobile & Tablet: Smooth infinite continuous Marquee with clean logos -->
    <div class="block lg:hidden overflow-hidden border border-[#e4e4e7] rounded-xl bg-white py-3 shadow-2xs">
      <div class="animate-marquee flex items-center gap-4">
        {[...integrations, ...integrations].map((item) => (
          <div class="flex items-center gap-2.5 shrink-0 px-3.5 py-1.5 rounded-lg bg-[#fafafa] border border-[#e4e4e7]" title={item.name}>
            <div class="h-5 w-5 flex items-center justify-center shrink-0">
              <Icon 
                name={item.icon} 
                class="h-5 w-5 object-contain"
              />
            </div>
            <span class="text-[12px] font-medium text-[#27272a] whitespace-nowrap">{item.name}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
