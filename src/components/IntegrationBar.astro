---
const integrations = [
  { name: 'Website Popup', type: 'website' },
  { name: 'WhatsApp', type: 'whatsapp' },
  { name: 'Instagram', type: 'instagram' },
  { name: 'Facebook', type: 'facebook' },
  { name: 'Messenger', type: 'messenger' },
  { name: 'Viber', type: 'viber' },
  { name: 'Shopify', type: 'shopify' },
  { name: 'WooCommerce', type: 'woocommerce' },
];
---

<section class="w-full bg-[#fafafa]/80 border-b border-[#e4e4e7]">
  <div class="mx-auto max-w-[1240px] px-6 py-10 lg:px-16 lg:border-x border-[#e4e4e7]">
    <div class="text-center text-[12px] font-semibold uppercase tracking-wider text-[#a1a1aa] mb-6">
      Povezuje se u nekoliko minuta s vašim omiljenim kanalima i sistemima
    </div>

    <!-- Desktop 8-cell Grid (Clean Official Logos) -->
    <div class="hidden lg:grid lg:grid-cols-8 border border-[#e4e4e7] rounded-xl overflow-hidden bg-white shadow-2xs">
      {integrations.map((item, idx) => (
        <div 
          class={`group relative flex h-20 items-center justify-center px-4 transition-all duration-200 ease-out hover:bg-slate-50/80 ${idx !== integrations.length - 1 ? 'border-r border-[#e4e4e7]' : ''}`}
          title={item.name}
        >
          <div class="h-9 w-9 flex items-center justify-center transition-transform duration-200 ease-out group-hover:scale-110 drop-shadow-2xs">
            {item.type === 'website' && (
              <svg class="h-9 w-9" viewBox="0 0 36 36" fill="none">
                <rect x="2" y="4" width="32" height="25" rx="5" fill="#f8fafc" stroke="#09090b" stroke-width="2.2"/>
                <path d="M2 12h32" stroke="#09090b" stroke-width="2"/>
                <circle cx="7" cy="8" r="1.5" fill="#09090b"/>
                <circle cx="11.5" cy="8" r="1.5" fill="#09090b"/>
                <circle cx="16" cy="8" r="1.5" fill="#09090b"/>
                <rect x="17" y="16" width="14" height="10" rx="3" fill="#2563eb"/>
                <path d="M25 26l2 2.5v-2.5h1" fill="#2563eb"/>
                <path d="M20 19.5h8M20 22.5h5" stroke="#ffffff" stroke-width="1.3" stroke-linecap="round"/>
              </svg>
            )}

            {item.type === 'whatsapp' && (
              <svg class="h-9 w-9" viewBox="0 0 32 32" fill="none">
                <circle cx="16" cy="16" r="15" fill="#25D366"/>
                <path fill="#ffffff" d="M22.5 19.2c-.3-.2-1.8-.9-2.1-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.2-1.3-.5-2.5-1.6-.9-.8-1.5-1.9-1.7-2.2-.2-.3 0-.5.1-.7.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5s-.7-1.7-1-2.3c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.7.1-1 .5-.4.4-1.4 1.3-1.4 3.3 0 1.9 1.4 3.8 1.6 4 .2.3 2.8 4.3 6.8 6 .9.4 1.7.6 2.3.8.9.3 1.8.3 2.5.2.8-.1 2.5-1 2.8-2 .4-1 .4-1.8.3-2-.1-.2-.3-.3-.6-.4z"/>
              </svg>
            )}

            {item.type === 'instagram' && (
              <svg class="h-9 w-9" viewBox="0 0 32 32" fill="none">
                <defs>
                  <radialGradient id="ig-official-grad" cx="20%" cy="110%" r="130%">
                    <stop offset="0%" stop-color="#ffdd55"/>
                    <stop offset="30%" stop-color="#ff543e"/>
                    <stop offset="60%" stop-color="#c837ab"/>
                    <stop offset="100%" stop-color="#3771c8"/>
                  </radialGradient>
                </defs>
                <rect width="32" height="32" rx="8" fill="url(#ig-official-grad)"/>
                <rect x="7" y="7" width="18" height="18" rx="5" stroke="#ffffff" stroke-width="2.2" fill="none"/>
                <circle cx="16" cy="16" r="4.3" stroke="#ffffff" stroke-width="2.2" fill="none"/>
                <circle cx="21.3" cy="10.7" r="1.3" fill="#ffffff"/>
              </svg>
            )}

            {item.type === 'facebook' && (
              <svg class="h-9 w-9" viewBox="0 0 32 32" fill="none">
                <circle cx="16" cy="16" r="15" fill="#1877F2"/>
                <path d="M20.5 16h-3.3v11h-4.4V16h-2.2v-3.8h2.2v-2.5c0-2.5 1.5-3.9 3.7-3.9 1.1 0 2 .1 2.3.1v2.6h-1.5c-1.2 0-1.4.6-1.4 1.4v2.3h2.9l-.4 3.8z" fill="#ffffff"/>
              </svg>
            )}

            {item.type === 'messenger' && (
              <svg class="h-9 w-9" viewBox="0 0 32 32" fill="none">
                <defs>
                  <linearGradient id="msgr-official-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#00C6FF"/>
                    <stop offset="45%" stop-color="#0078FF"/>
                    <stop offset="100%" stop-color="#A033FF"/>
                  </linearGradient>
                </defs>
                <path fill="url(#msgr-official-grad)" fill-rule="evenodd" clip-rule="evenodd" d="M16 2.5C8.82 2.5 3 7.99 3 14.77c0 3.86 1.89 7.3 4.85 9.55V28.5l4.08-2.24c1.3.36 2.68.56 4.07.56 7.18 0 13-5.49 13-12.27S23.18 2.5 16 2.5zm1.42 16.5l-3.32-3.54-6.48 3.54 7.13-7.57 3.4 3.54 6.4-3.54-7.13 7.57z"/>
              </svg>
            )}

            {item.type === 'viber' && (
              <svg class="h-9 w-9" viewBox="0 0 32 32" fill="none">
                <rect width="32" height="32" rx="8" fill="#7360F2"/>
                <path fill="#ffffff" d="M24 18.5c-.3-.2-1.8-.9-2.1-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.2-1.3-.5-2.5-1.6-.9-.8-1.5-1.9-1.7-2.2-.2-.3 0-.5.1-.7.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5s-.7-1.7-1-2.3c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.7.1-1 .5-.4.4-1.4 1.3-1.4 3.3 0 1.9 1.4 3.8 1.6 4 .2.3 2.8 4.3 6.8 6 .9.4 1.7.6 2.3.8.9.3 1.8.3 2.5.2.8-.1 2.5-1 2.8-2 .4-1 .4-1.8.3-2-.1-.2-.3-.3-.6-.4z"/>
                <path fill="#ffffff" d="M21.5 10c1.2.1 2.2.5 3 1.3.8.8 1.2 1.8 1.3 3 .1.2.2.3.4.3.2 0 .4-.1.4-.3-.1-1.4-.6-2.6-1.5-3.5-.9-.9-2.1-1.4-3.5-1.5-.2 0-.4.1-.4.3 0 .2.1.4.3.4z"/>
              </svg>
            )}

            {item.type === 'shopify' && (
              <svg class="h-9 w-9" viewBox="0 0 32 32" fill="none">
                <path d="M24.7 6.4c-.1-.7-.7-1.1-1.3-1.1-.1 0-.3 0-.4.1-.4-1.7-1.6-3.2-3.4-3.2-1.2 0-2.3.6-2.9 1.6-.7-.6-1.5-.9-2.4-.9-2.1 0-3.5 1.7-3.9 3.5l-3.3 1c-.9.3-1.5 1.1-1.5 2.1l-.8 17.7c-.1 1.7 1.2 3.1 2.9 3.3l15.3 1.8c.2 0 .4 0 .5 0 1.6 0 2.9-1.2 3-2.8L28 9.5c.1-.8-.4-1.6-1.2-1.8l-2.1-1.3zm-7-2.3c.7-.7 1.6-1.1 2.6-1.1 1.2 0 2.2.8 2.5 2l-5.1 1.6v-2.5zm-3.3 1.8c.3-1.2 1.3-2.3 2.6-2.3.2 0 .5 0 .7.1v2.9l-3.3.9v-1.6z" fill="#95BF47"/>
                <path d="M19.8 14.8c-.8-.2-1.7-.5-2.5-.7-2.4-.8-2.5-1.8-2.5-2.2 0-1.3 1.3-2 2.7-2 1.6 0 2.4.7 2.8 1.5.2.4.6.6 1 .5.4-.1.7-.5.6-1-.7-1.4-2.2-2.5-4.4-2.5-2.4 0-4.3 1.5-4.3 3.6 0 1.9 1.3 3.2 3.7 4 1.8.6 2.3.9 2.3 1.6 0 .9-.8 1.5-2.1 1.5-1.5 0-2.7-.7-3.3-1.9-.2-.4-.7-.6-1.1-.4-.4.2-.6.7-.4 1.1.9 1.8 2.8 2.8 4.8 2.8 2.5 0 4-1.4 4-3.4-.1-1.6-.9-2.4-2.8-2.9z" fill="#ffffff"/>
              </svg>
            )}

            {item.type === 'woocommerce' && (
              <svg class="h-9 w-9" viewBox="0 0 32 32" fill="none">
                <rect width="32" height="26" y="3" rx="6" fill="#96588A"/>
                <path d="M6 19l2.5-9h2.3l1.8 6.5 1.8-6.5h2.3l-2.5 9h-2.2l-1.8-6.3-1.8 6.3H6zm11.2 0l2.5-9H22l1.8 6.5 1.8-6.5h2.3l-2.5 9h-2.2l-1.8-6.3-1.8 6.3h-2.2z" fill="#ffffff"/>
              </svg>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- Mobile & Tablet: Smooth infinite continuous Marquee with clean logos -->
    <div class="block lg:hidden overflow-hidden border border-[#e4e4e7] rounded-xl bg-white py-4 shadow-2xs">
      <div class="animate-marquee flex items-center gap-8">
        {[...integrations, ...integrations].map((item) => (
          <div class="flex items-center justify-center shrink-0 px-2" title={item.name}>
            {item.type === 'website' && (
              <svg class="h-7 w-7" viewBox="0 0 36 36" fill="none">
                <rect x="2" y="4" width="32" height="25" rx="5" fill="#f8fafc" stroke="#09090b" stroke-width="2.2"/>
                <path d="M2 12h32" stroke="#09090b" stroke-width="2"/>
                <circle cx="7" cy="8" r="1.5" fill="#09090b"/>
                <circle cx="11.5" cy="8" r="1.5" fill="#09090b"/>
                <circle cx="16" cy="8" r="1.5" fill="#09090b"/>
                <rect x="17" y="16" width="14" height="10" rx="3" fill="#2563eb"/>
                <path d="M25 26l2 2.5v-2.5h1" fill="#2563eb"/>
                <path d="M20 19.5h8M20 22.5h5" stroke="#ffffff" stroke-width="1.3" stroke-linecap="round"/>
              </svg>
            )}

            {item.type === 'whatsapp' && (
              <svg class="h-7 w-7" viewBox="0 0 32 32" fill="none">
                <circle cx="16" cy="16" r="15" fill="#25D366"/>
                <path fill="#ffffff" d="M22.5 19.2c-.3-.2-1.8-.9-2.1-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.2-1.3-.5-2.5-1.6-.9-.8-1.5-1.9-1.7-2.2-.2-.3 0-.5.1-.7.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5s-.7-1.7-1-2.3c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.7.1-1 .5-.4.4-1.4 1.3-1.4 3.3 0 1.9 1.4 3.8 1.6 4 .2.3 2.8 4.3 6.8 6 .9.4 1.7.6 2.3.8.9.3 1.8.3 2.5.2.8-.1 2.5-1 2.8-2 .4-1 .4-1.8.3-2-.1-.2-.3-.3-.6-.4z"/>
              </svg>
            )}

            {item.type === 'instagram' && (
              <svg class="h-7 w-7" viewBox="0 0 32 32" fill="none">
                <defs>
                  <radialGradient id="ig-m-grad" cx="20%" cy="110%" r="130%">
                    <stop offset="0%" stop-color="#ffdd55"/>
                    <stop offset="30%" stop-color="#ff543e"/>
                    <stop offset="60%" stop-color="#c837ab"/>
                    <stop offset="100%" stop-color="#3771c8"/>
                  </radialGradient>
                </defs>
                <rect width="32" height="32" rx="8" fill="url(#ig-m-grad)"/>
                <rect x="7" y="7" width="18" height="18" rx="5" stroke="#ffffff" stroke-width="2.2" fill="none"/>
                <circle cx="16" cy="16" r="4.3" stroke="#ffffff" stroke-width="2.2" fill="none"/>
                <circle cx="21.3" cy="10.7" r="1.3" fill="#ffffff"/>
              </svg>
            )}

            {item.type === 'facebook' && (
              <svg class="h-7 w-7" viewBox="0 0 32 32" fill="none">
                <circle cx="16" cy="16" r="15" fill="#1877F2"/>
                <path d="M20.5 16h-3.3v11h-4.4V16h-2.2v-3.8h2.2v-2.5c0-2.5 1.5-3.9 3.7-3.9 1.1 0 2 .1 2.3.1v2.6h-1.5c-1.2 0-1.4.6-1.4 1.4v2.3h2.9l-.4 3.8z" fill="#ffffff"/>
              </svg>
            )}

            {item.type === 'messenger' && (
              <svg class="h-7 w-7" viewBox="0 0 32 32" fill="none">
                <defs>
                  <linearGradient id="msgr-m-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#00C6FF"/>
                    <stop offset="45%" stop-color="#0078FF"/>
                    <stop offset="100%" stop-color="#A033FF"/>
                  </linearGradient>
                </defs>
                <path fill="url(#msgr-m-grad)" fill-rule="evenodd" clip-rule="evenodd" d="M16 2.5C8.82 2.5 3 7.99 3 14.77c0 3.86 1.89 7.3 4.85 9.55V28.5l4.08-2.24c1.3.36 2.68.56 4.07.56 7.18 0 13-5.49 13-12.27S23.18 2.5 16 2.5zm1.42 16.5l-3.32-3.54-6.48 3.54 7.13-7.57 3.4 3.54 6.4-3.54-7.13 7.57z"/>
              </svg>
            )}

            {item.type === 'viber' && (
              <svg class="h-7 w-7" viewBox="0 0 32 32" fill="none">
                <rect width="32" height="32" rx="8" fill="#7360F2"/>
                <path fill="#ffffff" d="M24 18.5c-.3-.2-1.8-.9-2.1-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.2-1.3-.5-2.5-1.6-.9-.8-1.5-1.9-1.7-2.2-.2-.3 0-.5.1-.7.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5s-.7-1.7-1-2.3c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.7.1-1 .5-.4.4-1.4 1.3-1.4 3.3 0 1.9 1.4 3.8 1.6 4 .2.3 2.8 4.3 6.8 6 .9.4 1.7.6 2.3.8.9.3 1.8.3 2.5.2.8-.1 2.5-1 2.8-2 .4-1 .4-1.8.3-2-.1-.2-.3-.3-.6-.4z"/>
              </svg>
            )}

            {item.type === 'shopify' && (
              <svg class="h-7 w-7" viewBox="0 0 32 32" fill="none">
                <path d="M24.7 6.4c-.1-.7-.7-1.1-1.3-1.1-.1 0-.3 0-.4.1-.4-1.7-1.6-3.2-3.4-3.2-1.2 0-2.3.6-2.9 1.6-.7-.6-1.5-.9-2.4-.9-2.1 0-3.5 1.7-3.9 3.5l-3.3 1c-.9.3-1.5 1.1-1.5 2.1l-.8 17.7c-.1 1.7 1.2 3.1 2.9 3.3l15.3 1.8c.2 0 .4 0 .5 0 1.6 0 2.9-1.2 3-2.8L28 9.5c.1-.8-.4-1.6-1.2-1.8l-2.1-1.3zm-7-2.3c.7-.7 1.6-1.1 2.6-1.1 1.2 0 2.2.8 2.5 2l-5.1 1.6v-2.5zm-3.3 1.8c.3-1.2 1.3-2.3 2.6-2.3.2 0 .5 0 .7.1v2.9l-3.3.9v-1.6z" fill="#95BF47"/>
                <path d="M19.8 14.8c-.8-.2-1.7-.5-2.5-.7-2.4-.8-2.5-1.8-2.5-2.2 0-1.3 1.3-2 2.7-2 1.6 0 2.4.7 2.8 1.5.2.4.6.6 1 .5.4-.1.7-.5.6-1-.7-1.4-2.2-2.5-4.4-2.5-2.4 0-4.3 1.5-4.3 3.6 0 1.9 1.3 3.2 3.7 4 1.8.6 2.3.9 2.3 1.6 0 .9-.8 1.5-2.1 1.5-1.5 0-2.7-.7-3.3-1.9-.2-.4-.7-.6-1.1-.4-.4.2-.6.7-.4 1.1.9 1.8 2.8 2.8 4.8 2.8 2.5 0 4-1.4 4-3.4-.1-1.6-.9-2.4-2.8-2.9z" fill="#ffffff"/>
