---
---

<section class="reveal-on-scroll w-full bg-white border-b border-[#e4e4e7]">
  <div class="mx-auto max-w-[1240px] px-6 py-20 text-center lg:border-x border-[#e4e4e7] lg:px-16 lg:py-24">
    <div class="max-w-[640px] mx-auto">
      


      <h2 class="text-balance text-[2.25rem] font-medium leading-[1.12] tracking-[-0.03em] text-[#09090b] sm:text-[2.75rem]">
        Spremni za <span class="font-proza italic font-normal">novu eru</span> korisničke podrške?
      </h2>
      <p class="mt-4 text-[16px] leading-relaxed text-[#71717a] sm:text-[17px]">
        Unesite svoj e-mail i rezervišite prioritetan pristup. Prijave za ranu grupu su ograničene.
      </p>

      <!-- Bottom Waitlist Form -->
      <div class="mt-8 max-w-[480px] mx-auto">
        <form id="bottom-waitlist-form" class="flex flex-col sm:flex-row items-stretch gap-2.5">
          <input
            type="email"
            name="email"
            id="bottom-email-input"
            required
            placeholder="Vaš poslovni e-mail..."
            class="w-full rounded-xl border border-[#d4d4d8] bg-white px-4 py-3 text-[14px] text-[#09090b] placeholder-[#a1a1aa] shadow-xs outline-none transition-all focus:border-[#09090b] focus:ring-2 focus:ring-[#09090b]/10"
          />
          <button
            type="submit"
            id="bottom-submit-btn"
            class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-xl bg-[#09090b] px-6 py-3 text-[14px] font-medium text-white shadow-sm transition-all duration-200 hover:bg-[#27272a] hover:shadow-md active:scale-[0.98] shrink-0"
          >
            <span>Pridruži se</span>
            <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </form>

        <!-- Bottom Success Message -->
        <div id="bottom-success-msg" class="hidden mt-3 p-4 rounded-xl border border-emerald-200 bg-emerald-50 text-emerald-900 text-left">
          <div class="flex items-center gap-2 text-[14px] font-semibold text-emerald-800">
            <svg class="h-4 w-4 text-emerald-600 shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>Uspješno ste na listi!</span>
          </div>
          <p class="mt-1 text-[12px] text-emerald-700">
            Hvala na interesu. Obavijestit ćemo vas čim vaša pozicija bude spremna.
          </p>
        </div>

        <p class="mt-3 text-[12px] text-[#a1a1aa]">
          Poštujemo vašu privatnost. Nema spama, samo obavijest o dostupnosti.
        </p>
      </div>

    </div>
  </div>
</section>

<script>
  const bForm = document.getElementById('bottom-waitlist-form') as HTMLFormElement | null;
  const bInput = document.getElementById('bottom-email-input') as HTMLInputElement | null;
  const bBtn = document.getElementById('bottom-submit-btn') as HTMLButtonElement | null;
  const bSuccess = document.getElementById('bottom-success-msg');

  const saved = localStorage.getItem('pitaj_waitlist_email');
  if (saved && bSuccess && bForm) {
    bForm.classList.add('hidden');
    bSuccess.classList.remove('hidden');
  }

  if (bForm && bInput && bBtn && bSuccess) {
    bForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = bInput.value.trim();
      if (!email) return;

      bBtn.disabled = true;
      bBtn.innerHTML = `<span>Spremanje...</span>`;

      try {
        await fetch('/api/waitlist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, source: 'bottom' }),
        });
      } catch (err) {
        // graceful
      }

      localStorage.setItem('pitaj_waitlist_email', email);
      bForm.classList.add('hidden');
      bSuccess.classList.remove('hidden');
    });
  }
</script>
