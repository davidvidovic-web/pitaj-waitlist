---
---

<section class="reveal-on-scroll w-full bg-white">
  <div class="mx-auto max-w-[1240px] px-6 py-20 text-center lg:border-x border-[#e4e4e7] lg:px-16 lg:py-24">
    <div class="max-w-[640px] mx-auto">
      


      <h2 class="text-balance text-[2.25rem] font-medium leading-[1.12] tracking-[-0.03em] text-[#09090b] sm:text-[2.75rem]">
        Spremni za <span class="font-proza italic font-normal">novu eru</span> korisničke podrške?
      </h2>

      <!-- Bottom Waitlist Form -->
      <div class="mt-8 max-w-[480px] mx-auto">
        <form id="bottom-waitlist-form" class="flex flex-col sm:flex-row items-stretch gap-2.5">
          <input
            type="email"
            name="email"
            id="bottom-email-input"
            required
            placeholder="Vaš poslovni e-mail..."
            class="w-full rounded-xl border border-[#d4d4d8] bg-white px-4 py-3 text-[14px] text-[#09090b] placeholder-[#a1a1aa] shadow-xs outline-none transition-all focus:border-[#09090b] focus:ring-2 focus:ring-[#09090b]/10"
          />
          <button
            type="submit"
            id="bottom-submit-btn"
            class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-xl bg-[#09090b] px-6 py-3 text-[14px] font-medium text-white shadow-sm transition-all duration-200 hover:bg-[#27272a] hover:shadow-md active:scale-[0.98] shrink-0"
          >
            <span>Pridruži se</span>
            <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </form>

        <!-- Bottom Success Message -->
        <div id="bottom-success-msg" class="hidden mt-3 p-4 rounded-xl border border-emerald-200 bg-emerald-50 text-emerald-900 text-left">
          <div class="flex items-center gap-2 text-[14px] font-semibold text-emerald-800">
            <svg class="h-4 w-4 text-emerald-600 shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>Uspješno ste se prijavili za demo!</span>
          </div>
          <p class="mt-1 text-[12px] text-emerald-700">
            Hvala na interesu. Javit ćemo vam se za dogovor termina demo prezentacije.
          </p>
          <button id="bottom-reset-btn" type="button" class="mt-2 text-[12px] font-medium text-emerald-800 underline hover:text-emerald-950 cursor-pointer">
            Prijavite drugu e-mail adresu
          </button>
        </div>

        <!-- Bottom Error Message -->
        <div id="bottom-error-msg" class="hidden mt-3 p-3.5 rounded-xl border border-red-200 bg-red-50 text-red-800 text-[13px] text-left">
        </div>

        <p class="mt-3 text-[12px] text-[#a1a1aa]">
          Poštujemo vašu privatnost. Nema spama, samo obavijest o dostupnosti.
        </p>
      </div>

    </div>
  </div>
</section>

<script>
  const bForm = document.getElementById('bottom-waitlist-form') as HTMLFormElement | null;
  const bInput = document.getElementById('bottom-email-input') as HTMLInputElement | null;
  const bBtn = document.getElementById('bottom-submit-btn') as HTMLButtonElement | null;
  const bSuccess = document.getElementById('bottom-success-msg');
  const bError = document.getElementById('bottom-error-msg');
  const bResetBtn = document.getElementById('bottom-reset-btn');

  const defaultBottomBtnHtml = `
    <span>Pridruži se</span>
    <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  `;

  function resetBottomButton() {
    if (bBtn) {
      bBtn.disabled = false;
      bBtn.innerHTML = defaultBottomBtnHtml;
    }
  }

  const saved = localStorage.getItem('pitaj_waitlist_email');
  if (saved && bSuccess && bForm) {
    bForm.classList.add('hidden');
    bSuccess.classList.remove('hidden');
  }

  if (bResetBtn && bForm && bSuccess && bInput) {
    bResetBtn.addEventListener('click', () => {
      resetBottomButton();
      bForm.classList.remove('hidden');
      bSuccess.classList.add('hidden');
      localStorage.removeItem('pitaj_waitlist_email');
      bInput.value = '';
      bInput.focus();
    });
  }

  if (bForm && bInput && bBtn && bSuccess) {
    bForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = bInput.value.trim();
      if (!email) return;

      bBtn.disabled = true;
      bBtn.innerHTML = `
        <svg class="animate-spin h-4 w-4 text-white" viewBox="0 0 24 24" fill="none">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Spremanje...</span>
      `;
      if (bError) bError.classList.add('hidden');

      try {
        const response = await fetch('/api/waitlist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, source: 'bottom' }),
        });
        const data = await response.json();

        if (!response.ok || !data.success) {
          throw new Error(data?.error || 'Došlo je do greške prilikom prijave.');
        }

        if (typeof (window as any).gtag === 'function') {
          (window as any).gtag('event', 'generate_lead', {
            event_category: 'waitlist',
            event_label: 'bottom'
          });
        }

        localStorage.setItem('pitaj_waitlist_email', email);
        resetBottomButton();
        bForm.classList.add('hidden');
        bSuccess.classList.remove('hidden');
      } catch (err: any) {
        resetBottomButton();
        if (bError) {
          bError.textContent = err?.message || 'Došlo je do greške. Molimo pokušajte ponovo.';
          bError.classList.remove('hidden');
        }
      }
    });
  }
</script>
