---
import WaitlistForm from './WaitlistForm.astro';
---

<section id="demo" class="reveal-on-scroll w-full bg-white">
  <div class="mx-auto max-w-[1240px] px-6 py-20 text-center lg:border-x border-line lg:px-16 lg:py-24">
    <div class="max-w-[640px] mx-auto">
      


      <h2 class="text-balance text-[2.25rem] font-medium leading-[1.12] tracking-[-0.03em] text-ink sm:text-[2.75rem]">
        Spremni za <span class="font-proza italic font-normal">novu eru</span> korisničke podrške?
      </h2>

      <!-- Bottom Waitlist Form -->
      <div class="mt-8 max-w-[480px] mx-auto">
        <WaitlistForm
          prefix="bottom"
          source="bottom"
          size="md"
          align="center"
          placeholder="Vaš poslovni e-mail"
          buttonLabel="Zakažite demo"
          successTitle="Prijava je zaprimljena."
          successText="Javit ćemo vam se e-mailom radi dogovora demo prezentacije."
        />
        <p class="mt-3 text-[12px] text-subtle">
          Bez spama. E-mail koristimo za dogovor demo prezentacije.
        </p>
      </div>

    </div>
  </div>
</section>
