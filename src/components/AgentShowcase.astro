---
const agents = [
  {
    id: 'support-agent',
    surface: '#fdf2f8',
    accent: '#b0067e',
    dot: 'bg-emerald-500',
    label: 'Korisnička podrška',
    question: 'Kako mogu zamijeniti veličinu ako mi ne odgovara?',
    answer: 'Zamjena besplatna u 14 dana • Nalog kreiran',
    badge: 'AI Podrška',
    title: 'Agent za podršku',
    description: 'Odgovara na rutinske upite o narudžbama, zamjenama, dostavi i reklamacijama koristeći vašu bazu znanja.',
  },
  {
    id: 'sales-agent',
    surface: '#fffbeb',
    accent: '#b45309',
    dot: 'bg-blue-500',
    label: 'Prodaja & Preporuke',
    question: 'Tražim kremu za suhu kožu, šta preporučujete?',
    answer: 'Hydrating Glow Serum • 20% popusta',
    badge: 'E-Commerce',
    title: 'Agent za prodaju',
    description: 'Povežite WooCommerce katalog za preporuke proizvoda i informacije o zalihama. Shopify aplikacija je u pripremi.',
  },
  {
    id: 'guidance-agent',
    surface: '#eff6ff',
    accent: '#1d4ed8',
    dot: 'bg-emerald-500',
    label: 'Poliklinike & Usluge',
    question: 'Kada imate prvi slobodan termin za pregled zuba?',
    answer: 'Sutra u 10:30h ili 14:00h • Odaberite klikom',
    badge: 'Klinike & Saloni',
    title: 'Agent za termine i usluge',
    description: 'Idealan za stomatologe, ordinacije, kozmetičke salone i hotele. Odgovara na upite o pripremi za pregled, cijenama i bilježi termine.',
  },
];
---

<section class="reveal-on-scroll w-full bg-white">
  <div class="mx-auto max-w-[1240px] px-6 py-16 lg:border-x lg:border-b border-line lg:px-16 lg:py-20">
    <!-- Section Heading -->
    <div class="max-w-[780px]">
      <h2 class="text-balance text-[1.85rem] font-medium leading-[1.18] tracking-[-0.025em] text-ink sm:text-[2.25rem] lg:text-[2.5rem]">
        Jedan pametni agent za svaku interakciju, <span class="text-subtle">vodi podršku, prodaju i rezervacije 24/7</span>
      </h2>
    </div>

    <!-- 3 Agent Cards Grid -->
    <div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-3 lg:gap-6">
      {agents.map((agent) => (
        <div id={agent.id} class="group flex flex-col overflow-hidden rounded-2xl border border-line bg-sunken transition-all duration-300 hover:border-line-strong hover:shadow-xl hover:shadow-black/5">
          <!-- Primjer razgovora (ilustracija) -->
          <div class="flex aspect-[16/11] w-full flex-col justify-end gap-2.5 border-b border-line p-5" style={`background-color: ${agent.surface};`}>
            <div class="text-[12px] font-semibold uppercase tracking-wider" style={`color: ${agent.accent};`}>{agent.label}</div>
            <div class="ml-auto max-w-[88%] rounded-2xl rounded-br-md bg-ink px-3.5 py-2.5 text-[13px] font-medium leading-snug text-white">
              {agent.question}
            </div>
            <div class="flex max-w-[92%] items-center gap-2 rounded-2xl rounded-bl-md border border-line bg-white px-3.5 py-2.5 text-[12.5px] leading-snug text-ink-mid shadow-xs transition-transform duration-300 group-hover:-translate-y-0.5">
              <span class={`h-1.5 w-1.5 shrink-0 rounded-full ${agent.dot}`}></span>
              <span>{agent.answer}</span>
            </div>
          </div>

          <div class="flex flex-1 flex-col justify-between p-6 sm:p-7">
            <div>
              <span class="inline-block rounded-md border border-line bg-white px-2 py-0.5 text-[12px] font-semibold uppercase tracking-wider text-muted">{agent.badge}</span>
              <h3 class="mt-3 text-[18px] font-semibold text-ink">{agent.title}</h3>
              <p class="mt-2 text-[14px] leading-relaxed text-muted">{agent.description}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
