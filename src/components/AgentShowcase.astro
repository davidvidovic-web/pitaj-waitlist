---
---

<section class="reveal-on-scroll w-full bg-white">
  <div class="mx-auto max-w-[1240px] px-6 py-16 lg:border-x lg:border-b border-[#e4e4e7] lg:px-16 lg:py-20">
    <!-- Section Heading -->
    <div class="max-w-[780px]">
      <h2 class="text-balance text-[1.85rem] font-medium leading-[1.18] tracking-[-0.025em] text-[#09090b] sm:text-[2.25rem] lg:text-[2.5rem]">
        Jedan pametni agent za svaku interakciju, <span class="text-[#71717a]">vodi podršku, prodaju i rezervacije 24/7</span>
      </h2>
    </div>

    <!-- 3 Agent Cards Grid -->
    <div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-3 lg:gap-6">
      <!-- Card 1: Support agent -->
      <div id="support-agent" class="group flex flex-col overflow-hidden rounded-2xl border border-[#e4e4e7] bg-[#fafafa] transition-all duration-300 hover:shadow-xl hover:shadow-black/5 hover:border-[#d4d4d8] hover:-translate-y-1">
        <div class="relative aspect-[16/11] w-full overflow-hidden border-b border-[#e4e4e7] bg-white">
          <!-- Default Image -->
          <img
            src="/chatbase-assets/feature-ai-native.1h2_0tl4258qa.webp"
            alt="Agent za korisničku podršku"
            class="h-full w-full object-cover transition-opacity duration-300 group-hover:opacity-0"
          />

          <!-- Hover Background with Grain -->
          <div class="absolute inset-0 opacity-0 transition-opacity duration-500 ease-out group-hover:opacity-100">
            <img
              src="/chatbase-assets/feature-hover-support-bg.0xhrqnknms0su.svg"
              alt=""
              aria-hidden="true"
              class="h-full w-full object-cover"
            />
            <img
              src="/chatbase-assets/grain.2yo71lp6k8fnp.webp"
              alt=""
              aria-hidden="true"
              class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-25 mix-blend-color-dodge"
            />
            <!-- Floating Cube Graphic -->
            <img
              src="/chatbase-assets/feature-cube-support.webp"
              alt=""
              class="absolute right-4 top-4 h-16 w-auto object-contain transition-transform duration-500 group-hover:translate-y-1 group-hover:scale-110 drop-shadow-md"
            />
          </div>

          <!-- Overlay dialogue preview on card -->
          <div class="absolute inset-0 flex flex-col justify-end p-5 pointer-events-none">
            <div class="rounded-xl border border-white/70 bg-white/90 p-3.5 backdrop-blur-md shadow-xs transition-transform duration-300 group-hover:-translate-y-1 group-hover:shadow-md">
              <div class="text-[11px] font-semibold uppercase tracking-wider text-[#b0067e]">Korisnička podrška</div>
              <div class="mt-1 text-[13px] font-medium text-[#09090b]">"Kako mogu zamijeniti veličinu ako mi ne odgovara?"</div>
              <div class="mt-1.5 flex items-center gap-1.5 text-[12px] text-[#52525b]">
                <span class="flex h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                <span>Zamjena besplatna u 14 dana • Nalog kreiran</span>
              </div>
            </div>
          </div>
        </div>

        <div class="flex flex-1 flex-col justify-between p-6 sm:p-7">
          <div>
            <div class="flex items-center gap-2">
              <span class="rounded-md border border-[#e4e4e7] bg-white px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-[#71717a]">AI Podrška</span>
            </div>
            <h3 class="mt-3 text-[18px] font-semibold text-[#09090b]">Agent za podršku</h3>
            <p class="mt-2 text-[14px] leading-relaxed text-[#52525b]">
              Automatski rješava do 80% rutinskih upita o narudžbama, zamjenama, dostavi i reklamacijama bez opterećenja vašeg tima.
            </p>
          </div>
        </div>
      </div>

      <!-- Card 2: Sales agent -->
      <div id="sales-agent" class="group flex flex-col overflow-hidden rounded-2xl border border-[#e4e4e7] bg-[#fafafa] transition-all duration-300 hover:shadow-xl hover:shadow-black/5 hover:border-[#d4d4d8] hover:-translate-y-1">
        <div class="relative aspect-[16/11] w-full overflow-hidden border-b border-[#e4e4e7] bg-white">
          <!-- Default Image -->
          <img
            src="/chatbase-assets/feature-omnichannel.webp"
            alt="Agent za prodaju i preporuku"
            class="h-full w-full object-cover transition-opacity duration-300 group-hover:opacity-0"
          />

          <!-- Hover Background with Grain & Sales Blue Cube with Money Bag -->
          <div class="absolute inset-0 opacity-0 transition-opacity duration-500 ease-out group-hover:opacity-100">
            <img
              src="/chatbase-assets/feature-hover-sales-bg.0nvyhopqv5ajy.svg"
              alt=""
              aria-hidden="true"
              class="h-full w-full object-cover"
            />
            <img
              src="/chatbase-assets/grain.2yo71lp6k8fnp.webp"
              alt=""
              aria-hidden="true"
              class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-25 mix-blend-color-dodge"
            />
            <img
              src="/chatbase-assets/feature-cube-sales.09acsr5rgyi2o.webp"
              alt=""
              class="absolute right-4 top-4 h-16 w-auto object-contain transition-transform duration-500 group-hover:translate-y-1 group-hover:scale-110 drop-shadow-md"
            />
          </div>

          <!-- Overlay dialogue preview on card -->
          <div class="absolute inset-0 flex flex-col justify-end p-5 pointer-events-none">
            <div class="rounded-xl border border-white/70 bg-white/90 p-3.5 backdrop-blur-md shadow-xs transition-transform duration-300 group-hover:-translate-y-1 group-hover:shadow-md">
              <div class="text-[11px] font-semibold uppercase tracking-wider text-[#d97706]">Prodaja & Preporuke</div>
              <div class="mt-1 text-[13px] font-medium text-[#09090b]">"Tražim kremu za suhu kožu, šta preporučujete?"</div>
              <div class="mt-1.5 flex items-center gap-1.5 text-[12px] text-[#52525b]">
                <span class="flex h-1.5 w-1.5 rounded-full bg-blue-500"></span>
                <span>Hydrating Glow Serum • 20% popusta</span>
              </div>
            </div>
          </div>
        </div>

        <div class="flex flex-1 flex-col justify-between p-6 sm:p-7">
          <div>
            <div class="flex items-center gap-2">
              <span class="rounded-md border border-[#e4e4e7] bg-white px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-[#71717a]">E-Commerce</span>
            </div>
            <h3 class="mt-3 text-[18px] font-semibold text-[#09090b]">Agent za prodaju</h3>
            <p class="mt-2 text-[14px] leading-relaxed text-[#52525b]">
              Povezan direktno s WooCommerce i Shopify bazom. Preporučuje proizvode, provjerava stanje zaliha i vodi posjetioce do kupovine.
            </p>
          </div>
        </div>
      </div>

      <!-- Card 3: Booking & Services agent -->
      <div id="guidance-agent" class="group flex flex-col overflow-hidden rounded-2xl border border-[#e4e4e7] bg-[#fafafa] transition-all duration-300 hover:shadow-xl hover:shadow-black/5 hover:border-[#d4d4d8] hover:-translate-y-1">
        <div class="relative aspect-[16/11] w-full overflow-hidden border-b border-[#e4e4e7] bg-white">
          <!-- Default Image -->
          <img
            src="/chatbase-assets/feature-smarter.1j0gv02lsnr5_.webp"
            alt="Agent za rezervacije i poliklinike"
            class="h-full w-full object-cover transition-opacity duration-300 group-hover:opacity-0"
          />

          <!-- Hover Background with Brand Cube Graphic -->
          <div class="absolute inset-0 opacity-0 transition-opacity duration-500 ease-out group-hover:opacity-100">
            <img
              src="/chatbase-assets/feature-hover-brand-bg.2ty8w8s8z6js8.svg"
              alt=""
              aria-hidden="true"
              class="h-full w-full object-cover"
            />
            <img
              src="/chatbase-assets/grain.2yo71lp6k8fnp.webp"
              alt=""
              aria-hidden="true"
              class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-25 mix-blend-color-dodge"
            />
            <img
              src="/chatbase-assets/feature-cube-brand.2llv50pb_gyud.webp"
              alt=""
              class="absolute right-4 top-4 h-16 w-auto object-contain transition-transform duration-500 group-hover:translate-y-1 group-hover:scale-110 drop-shadow-md"
            />
          </div>

          <!-- Overlay dialogue preview on card -->
          <div class="absolute inset-0 flex flex-col justify-end p-5 pointer-events-none">
            <div class="rounded-xl border border-white/70 bg-white/90 p-3.5 backdrop-blur-md shadow-xs transition-transform duration-300 group-hover:-translate-y-1 group-hover:shadow-md">
              <div class="text-[11px] font-semibold uppercase tracking-wider text-[#2563eb]">Poliklinike & Usluge</div>
              <div class="mt-1 text-[13px] font-medium text-[#09090b]">"Kada imate prvi slobodan termin za pregled zuba?"</div>
              <div class="mt-1.5 flex items-center gap-1.5 text-[12px] text-[#52525b]">
                <span class="flex h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                <span>Sutra u 10:30h ili 14:00h • Odaberite klikom</span>
              </div>
            </div>
          </div>
        </div>

        <div class="flex flex-1 flex-col justify-between p-6 sm:p-7">
          <div>
            <div class="flex items-center gap-2">
              <span class="rounded-md border border-[#e4e4e7] bg-white px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-[#71717a]">Klinike & Saloni</span>
            </div>
            <h3 class="mt-3 text-[18px] font-semibold text-[#09090b]">Agent za termine i usluge</h3>
            <p class="mt-2 text-[14px] leading-relaxed text-[#52525b]">
              Idealan za stomatologe, ordinacije, kozmetičke salone i hotele. Odgovara na upite o pripremi za pregled, cijenama i bilježi termine.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
